{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ──────────────────────────────────────────────────────────────────────────
  // Analysis provider selection
  // ──────────────────────────────────────────────────────────────────────────
  // Set AnalysisProvider to "Watsonx" to use IBM watsonx.ai.
  // Set AnalysisProvider to "Mock" (or leave unset) for offline development.
  // When Watsonx is selected but credentials are missing the application will
  // automatically fall back to Mock and log a warning.
  // ──────────────────────────────────────────────────────────────────────────
  "AnalysisProvider": "Mock",

  // ──────────────────────────────────────────────────────────────────────────
  // IBM watsonx.ai configuration
  // ──────────────────────────────────────────────────────────────────────────
  // Do NOT put real credentials here.
  // Override the placeholders below using environment variables:
  //   IBM_WATSONX_URL        → Watsonx:Url
  //   IBM_WATSONX_API_KEY    → Watsonx:ApiKey
  //   IBM_WATSONX_PROJECT_ID → Watsonx:ProjectId
  //   IBM_WATSONX_MODEL_ID   → Watsonx:ModelId  (optional — has a default)
  // ──────────────────────────────────────────────────────────────────────────
  "Watsonx": {
    "Url":          "",
    "ApiKey":       "",
    "ProjectId":    "",
    "ModelId":      "ibm/granite-3-8b-instruct",
    "ApiVersion":   "2025-02-11",
    "MaxNewTokens": 1200
  }
}
